# Copy to .env (gitignored). All values optional; defaults run offline against the fixture with the rules provider.
# Comments stay on their own lines so the file also works with `docker run --env-file` / compose env_file.
UPSTREAM_BASE_URL=http://127.0.0.1:8080
# MODEL_PROVIDER=rules   (rules | openai_compatible; auto: openai_compatible when OPENAI_API_KEY is set)
# OPENAI_BASE_URL=https://api.openai.com/v1   (any OpenAI-compatible endpoint: Groq, Ollama, vLLM, DO serverless inference)
# OPENAI_API_KEY=
# MODEL_ID=gpt-4o-mini
PROMPT_VERSION=v1
DEADLINE_MS=20000
READ_TIMEOUT_S=2.0
WRITE_TIMEOUT_S=3.0
RUNS_DIR=runs
DRY_RUN=true

# ---- retries / model call ----
# Upstream reads retry on timeout / 429 / 5xx, never on 4xx; writes never retry.
MAX_RETRIES=3
# Model calls: same status-based policy.
LLM_MAX_RETRIES=3
LLM_TIMEOUT_S=30
# Stream the completion so time-to-first-token / inter-token gaps are measured.
LLM_STREAM=true

# ---- observability ----
# true: also emit every trace record as a JSON line on stdout (App Platform log forwarding).
TRACE_STDOUT=false
# Label on metrics / trace lines.
SERVICE_NAME=ic4-agent
# Durability of runs/ (agent/persist.py). Unset = disabled (files only). Finished runs and evals are
# mirrored to this database the moment they complete and restored into RUNS_DIR on start, so a redeploy
# of the hosted agent loses no history, traces or eval comparisons.
#   postgresql://doadmin:...@host:25060/defaultdb?sslmode=require   (DO Managed PostgreSQL; needs psycopg)
#   sqlite:///runs/persist.sqlite                                     (local experiments / tests)
# DATABASE_URL=

# ---- DigitalOcean serverless inference (OpenAI-compatible) ----
# OPENAI_BASE_URL=https://inference.do-ai.run/v1
# MODEL_ID=openai-gpt-4o-mini   (also: openai-gpt-5-nano, openai-gpt-oss-120b, anthropic-claude-haiku-4.5)
# OPENAI_API_KEY is a Gradient *model access key* (inference-only), created in the control panel under
# Gradient AI Platform > Serverless inference > Model access keys. It is NOT the DigitalOcean API token.
# OPENAI_API_KEY=
